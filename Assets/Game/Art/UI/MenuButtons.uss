.menu-option {
    background-color: rgb(255, 255, 255);
    color: white;
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 80px;
    -unity-font-definition: url("project://database/Assets/Game/Art/UI/Font/GasoekOne-Regular.ttf?fileID=12800000&guid=254b63d13b4f72f499df8d30bf20eda2&type=3#GasoekOne-Regular");
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 30px;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 8px;
    padding-left: 0;
    height: -24px;
    min-height: -32px;
    max-height: 64px;
    transition-property: background-color, color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.menu-option.selected {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 90px;
    -unity-font-definition: url("project://database/Assets/Game/Art/UI/Font/GasoekOne-Regular.ttf?fileID=12800000&guid=254b63d13b4f72f499df8d30bf20eda2&type=3#GasoekOne-Regular");
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 30px;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 8px;
    padding-left: 0;
    height: -24px;
    min-height: -32px;
    max-height: 64px;
}



.selected {
}
