:root {
}

.ButtonBig {
    -unity-font-definition: url("project://database/Assets/Game/Art/UI/Font/GasoekOne-Regular.ttf?fileID=12800000&guid=254b63d13b4f72f499df8d30bf20eda2&type=3#GasoekOne-Regular");
    font-size: 78px;
    background-color: rgb(255, 217, 0);
    align-self: center;
    justify-content: flex-end;
    align-content: center;
    padding-right: 96px;
    padding-left: 96px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    padding-top: 0;
    padding-bottom: 0;
    margin-bottom: 36px;
    min-height: 180px;
    max-height: 180px;
    min-width: 926px;
    max-width: 926px;
    width: 1638px;
}

.Header {
    -unity-font-definition: url("project://database/Assets/Game/Art/UI/Font/GasoekOne-Regular.ttf?fileID=12800000&guid=254b63d13b4f72f499df8d30bf20eda2&type=3#GasoekOne-Regular");
    font-size: 128px;
    -unity-text-align: middle-center;
    -unity-background-scale-mode: scale-and-crop;
    background-position-x: center;
    background-size: 100% 100px;
    text-overflow: clip;
    margin-top: 0;
    margin-bottom: 0;
    background-color: rgb(255, 255, 255);
    padding-top: 0;
    margin-right: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-left: 0;
    color: rgb(0, 0, 0);
}

.unity-integer-field {
}

#InsertRoom > #Body > .ButtonBig > #unity-text-input {
    -unity-text-align: middle-center;
    -unity-background-image-tint-color: rgb(0, 0, 0);
    background-color: rgba(255, 255, 255, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}
